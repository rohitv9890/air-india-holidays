{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethiopianholidays.example/schemas/connections.schema.json",
  "title": "Guzo Destination Journey Connections",
  "type": "object",
  "required": ["schemaVersion", "version", "connections"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "version": { "type": "string", "pattern": "^v[0-9]+$" },
    "defaultGatewayId": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" },
    "connections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/connection" }
    }
  },
  "$defs": {
    "connection": {
      "type": "object",
      "required": ["id", "from", "to", "mode", "hours", "load"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "pattern": "^conn-[a-z0-9-]+$"
        },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "mode": {
          "type": "string",
          "enum": ["flight", "road", "boat", "trek"]
        },
        "hours": { "type": "number", "minimum": 0.1, "maximum": 24 },
        "load": {
          "type": "string",
          "enum": ["short", "half-day", "full-day"]
        },
        "flightRouteId": { "type": "string" },
        "transferId": { "type": "string" },
        "reciprocalId": { "type": "string" },
        "via": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "seasonality": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
