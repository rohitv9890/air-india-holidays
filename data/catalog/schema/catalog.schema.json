{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethiopianholidays.example/schemas/catalog.schema.json",
  "title": "Guzo Deployable Catalog",
  "type": "object",
  "required": ["schemaVersion", "version", "currency", "products"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "version": { "type": "string", "pattern": "^v[0-9]+$" },
    "currency": { "type": "string", "const": "GBP" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/product" }
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "required": ["amount", "currency"],
      "additionalProperties": false,
      "properties": {
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "enum": ["GBP", "EUR", "USD", "ETB"] },
        "basis": {
          "type": "string",
          "enum": [
            "per-person",
            "per-person-sharing",
            "per-group",
            "per-vehicle",
            "flat",
            "per-night",
            "per-room"
          ]
        }
      }
    },
    "priceProvenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceAmount": { "type": "number" },
        "sourceCurrency": { "type": "string", "enum": ["GBP", "EUR", "USD", "ETB"] },
        "sourceBasis": {
          "type": "string",
          "enum": [
            "per-person",
            "per-person-sharing",
            "per-group",
            "per-vehicle",
            "flat",
            "per-night",
            "per-room"
          ]
        },
        "fxRateToGbp": { "type": "number", "minimum": 0 },
        "fxDate": { "type": "string" },
        "convertedAmount": { "type": "number", "minimum": 0 },
        "convertedCurrency": { "type": "string", "const": "GBP" },
        "notes": { "type": "string" }
      }
    },
    "image": {
      "type": "object",
      "required": ["url", "alt"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "alt": { "type": "string", "minLength": 1 },
        "credit": { "type": "string" }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "days": { "type": "integer", "minimum": 0 },
        "nights": { "type": "integer", "minimum": 0 },
        "hours": { "type": "number", "minimum": 0 }
      }
    },
    "seasonality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "peakMonths": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 12 }
        },
        "rainyMonths": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 12 }
        },
        "availableMonths": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 12 }
        },
        "notes": { "type": "string" }
      }
    },
    "easygds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packageId": { "type": ["string", "null"] },
        "placeId": { "type": ["string", "null"] },
        "hotelId": { "type": ["string", "null"] },
        "flightConfigId": { "type": ["string", "null"] },
        "productCode": { "type": ["string", "null"] }
      }
    },
    "routeStop": {
      "type": "object",
      "required": ["sequence", "destinationId"],
      "additionalProperties": false,
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "destinationId": { "type": "string" },
        "nights": { "type": "integer", "minimum": 0 },
        "transportToNext": {
          "type": ["string", "null"],
          "enum": ["flight", "road", "boat", "trek", null]
        }
      }
    },
    "relationship": {
      "type": "object",
      "required": ["type", "productId"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "included",
            "optional-addon",
            "extension",
            "alternative",
            "tier-upgrade"
          ]
        },
        "productId": { "type": "string", "minLength": 3 },
        "note": { "type": "string" }
      }
    },
    "dayTemplate": {
      "type": "object",
      "required": ["day"],
      "additionalProperties": false,
      "properties": {
        "day": { "type": "integer", "minimum": 1 },
        "moduleId": { "type": "string", "minLength": 3 },
        "destinationId": { "type": "string" },
        "experienceIds": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "flightLegGap": {
      "type": "object",
      "required": ["fromIata", "toIata", "reason"],
      "additionalProperties": false,
      "properties": {
        "fromDestinationId": { "type": "string" },
        "toDestinationId": { "type": "string" },
        "fromIata": { "type": "string" },
        "toIata": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "product": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name",
        "summary",
        "destinations",
        "themes",
        "tier",
        "basePrice",
        "inclusions",
        "exclusions",
        "images",
        "seasonality",
        "compatibility",
        "status",
        "availabilityMode"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "type": {
          "type": "string",
          "enum": [
            "destination",
            "package",
            "accommodation",
            "experience",
            "transfer",
            "flight"
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "destinations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "themes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "duration": { "$ref": "#/$defs/duration" },
        "tier": {
          "type": "string",
          "enum": ["classic", "comfort", "signature"]
        },
        "basePrice": { "$ref": "#/$defs/money" },
        "priceProvenance": { "$ref": "#/$defs/priceProvenance" },
        "inclusions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exclusions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "inclusionCompleteness": {
          "type": "string",
          "enum": ["complete", "partial", "unknown"]
        },
        "exclusionCompleteness": {
          "type": "string",
          "enum": ["complete", "partial", "unknown"]
        },
        "images": {
          "type": "array",
          "items": { "$ref": "#/$defs/image" }
        },
        "easygds": { "$ref": "#/$defs/easygds" },
        "seasonality": { "$ref": "#/$defs/seasonality" },
        "compatibility": {
          "type": "array",
          "items": { "type": "string" }
        },
        "route": {
          "type": "array",
          "items": { "$ref": "#/$defs/routeStop" }
        },
        "iata": { "type": "string", "minLength": 3, "maxLength": 3 },
        "cluster": { "type": "string" },
        "region": { "type": "string" },
        "origin": { "type": "string" },
        "destination": { "type": "string" },
        "cabinMultipliers": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "stars": { "type": "number", "minimum": 0, "maximum": 5 },
        "relatedIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "relationships": {
          "type": "array",
          "items": { "$ref": "#/$defs/relationship" }
        },
        "status": {
          "type": "string",
          "enum": ["active", "draft", "rejected"]
        },
        "sourceRefs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "availabilityMode": {
          "type": "string",
          "enum": ["indicative", "allotment", "on-request"]
        },
        "blockers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "travellerFit": {
          "type": "array",
          "items": { "type": "string" }
        },
        "pace": {
          "type": "string",
          "enum": ["relaxed", "moderate", "active"]
        },
        "accessibilityNotes": { "type": "string" },
        "minDurationDays": { "type": "integer", "minimum": 1 },
        "maxDurationDays": { "type": "integer", "minimum": 1 },
        "permittedExtraNights": { "type": "integer", "minimum": 0 },
        "combinableDestinations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dayTemplates": {
          "type": "array",
          "items": { "$ref": "#/$defs/dayTemplate" }
        },
        "originFlightPoint": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "unsupportedFlightLegs": {
          "type": "array",
          "items": { "$ref": "#/$defs/flightLegGap" }
        }
      }
    }
  }
}
